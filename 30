{ "indexes": [], "fieldOverrides": [] }

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Main admins: create a document admins/<their uid> manually in the Firebase console.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin flag: a user may only check their own; nobody can write it from the app.
    match /admins/{uid} {
      allow get: if isSelf(uid);
    }

    // Display names: visible only to the user and to admins.
    match /profiles/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isSelf(uid);
    }

    // Business profiles: everyone signed in can read; the owner (or an admin) writes.
    match /businesses/{uid} {
      allow read: if signedIn();
      allow create, update: if (isSelf(uid) || isAdmin())
        && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list is list
        && request.resource.data.list.size() <= 10;
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Suspended businesses: only admins write.
    match /suspended/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Cancellations made by a business for its own bookings.
    match /cancelled/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid) || isAdmin();
    }

    // Claimed time slots (what makes a slot "taken"); each customer writes only their own document.
    match /taken/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    // Private booking details (name, phone, notes): the customer, and admins for reading.
    match /bookings/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if isSelf(uid);
    }
  }
}

